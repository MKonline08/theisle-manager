# Change these before exposing the panel to the internet.
POSTGRES_DB=theisle_manager
POSTGRES_USER=theisle
POSTGRES_PASSWORD=change-this-to-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-characters
PANEL_PORT=8080
TZ=UTC
# Steam's The Isle Dedicated Server app id. Override if the vendor changes it.
STEAM_APP_ID=412680
# Image used for the managed game-server containers.
THEISLE_SERVER_IMAGE=theisle-manager-server:latest
# Optional, comma-separated origins when hosting the UI somewhere else.
CORS_ORIGINS=
